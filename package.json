{
  "name": "wechat-channels-ai-assistant",
  "description": "微信视频号 AI 创作助手：脚本生成、视频审片、数据分析与热点研究。Local-first AI assistant for WeChat Channels creators.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SherlockMF/wechat-channels-ai-assistant.git"
  },
  "homepage": "https://github.com/SherlockMF/wechat-channels-ai-assistant#readme",
  "bugs": {
    "url": "https://github.com/SherlockMF/wechat-channels-ai-assistant/issues"
  },
  "keywords": ["wechat", "wechat-channels", "ai-assistant", "video-analysis", "script-writing", "qwen"],
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @video-diagnosis/web",
    "build": "npm run build --workspace @video-diagnosis/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @video-diagnosis/web",
    "test:worker": "python -m pytest apps/worker/tests",
    "db:generate": "npm run db:generate --workspace @video-diagnosis/database"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "rollup": "4.62.3",
    "vite": "8.0.13"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.3"
  }
}
