{
  "name": "wechat-channels-content-diagnosis",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @video-diagnosis/web",
    "build": "npm run build --workspace @video-diagnosis/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @video-diagnosis/web",
    "test:worker": "python -m pytest apps/worker/tests",
    "db:generate": "npm run db:generate --workspace @video-diagnosis/database"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "rollup": "4.62.3",
    "vite": "8.0.13"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.3"
  }
}
