APP_MODE=LOCAL
NEXT_PUBLIC_APP_MODE=LOCAL
REPOSITORY_BACKEND=local
# 可选：本地工作簿/视频。没有样例数据时留空即可，脚本工作台仍可生成。
LOCAL_SOURCE_WORKBOOK=
LOCAL_VIDEO_DIRECTORY=
USER_SETTINGS_PATH=.data/user-settings.json
WORKER_URL=http://127.0.0.1:8000
PRIVATE_STORAGE_ROOT=.data/uploads
SIGNED_URL_SECRET=replace-with-a-long-random-value
MAX_VIDEO_FILE_MB=500
MAX_VIDEO_FILES=100

# 阿里云百炼（填同一 Key 即可）
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SPEECH_PROVIDER=dashscope
SPEECH_API_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=qwen-audio-3.0-asr-flash

VISION_PROVIDER=dashscope
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus

LLM_PROVIDER=dashscope
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_DRAFT_REVIEW_URL=

# 主模型/Key 额度或限流触发时按顺序自动降级（逗号分隔）
LLM_MODEL_FALLBACKS=qwen-plus-2025-07-28,qwen-turbo,qwen-max
VISION_MODEL_FALLBACKS=qwen-vl-max,qwen2.5-vl-72b-instruct,qwen-plus
SPEECH_MODEL_FALLBACKS=fun-asr-flash,qwen3-asr-flash
WEB_RESEARCH_MODEL_FALLBACKS=qwen-plus-2025-07-28,qwen-turbo,qwen-max
# 额外备选 Key（与设置页 Speech/Vision/LLM/Research 槽位叠加去重）
DASHSCOPE_API_KEY_FALLBACKS=

WORKER_POLL_INTERVAL_SECONDS=3
MAX_KEY_FRAMES=40
