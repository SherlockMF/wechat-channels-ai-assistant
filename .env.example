WORKER_URL=http://127.0.0.1:8000
PRIVATE_STORAGE_ROOT=.data/uploads
SIGNED_URL_SECRET=replace-with-a-long-random-value
MAX_VIDEO_FILE_MB=500
MAX_VIDEO_FILES=100

